{
  "name": "restro-os-pos",
  "version": "1.0.0",
  "description": "Restro-OS Enterprise Restaurant POS & Kitchen Display Desktop Software",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "restaurant",
    "pos",
    "kds",
    "billing",
    "thermal-printer",
    "desktop-app"
  ],
  "author": "The Grand Estate / Divflow",
  "license": "Commercial",
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.restroos.pos",
    "productName": "Restro-OS Enterprise POS",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Restro-OS POS"
    }
  }
}