# ==============================================
# Divflow Environment Configuration (.env.example)
# Copy this file to .env and fill in your keys
# ==============================================

# n8n Configuration
N8N_PORT=5678
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# Free AI API Keys (Zero Cost)
# Get Google Gemini Key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Get Groq Key (Fast Llama 3): https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Telegram Bot API (100% Free via @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Meta WhatsApp Cloud API (Free 1,000 conversations/mo)
WHATSAPP_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=divflow_verify_token_123

# Chatwoot CRM
CHATWOOT_API_TOKEN=your_chatwoot_token_here
CHATWOOT_ACCOUNT_ID=1
